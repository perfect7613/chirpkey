# --- Bolna ---
BOLNA_API_KEY=bn-your-key
# Filled in after `npm run setup-agent` (classic) and `npm run setup-agent -- --graph` (live events)
BOLNA_AGENT_ID=
BOLNA_GRAPH_AGENT_ID=
# Optional: a Bolna-bought number (E.164) for "Call my phone" and inbound calls
BOLNA_PHONE_NUMBER=
OWNER_PHONE=

# Public https URL of this server (ngrok or a deployed host). Bolna calls the tools here; phones need https for the mic.
PUBLIC_URL=https://your-subdomain.ngrok-free.app
PORT=3000

# --- Security ---
# Bolna sends this as "Authorization: Bearer <token>" on every tool call. Use a long random string.
TOOLS_TOKEN=change-me-long-random
# Signs chirp packets so a recorded or made-up chirp can't approve anything.
CHIRP_SIGNING_SECRET=change-me-long-random
# Executors (e.g. Grok Bot) send this back when reporting results. Defaults to TOOLS_TOKEN.
CALLBACK_TOKEN=
# Spoken on the call before any action. Words beat digits for speech recognition.
SECRET_PHRASE=bravo
OWNER_NAME=

# --- Chirp ---
# GGWAVE_PROTOCOL_AUDIBLE_FAST (default, audible) | GGWAVE_PROTOCOL_DT_FASTEST (dual-tone, robust) | GGWAVE_PROTOCOL_ULTRASOUND_FASTEST (near-silent)
CHIRP_PROTOCOL=GGWAVE_PROTOCOL_AUDIBLE_FAST

# --- Executors: unset = simulated ---
# Grok Bot routine webhook ("POST to" URL and key from the routine's Webhook trigger)
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
# Claude Code and Codex run on this machine. Set a folder to enable each.
CLAUDE_CODE_WORKDIR=
# acceptEdits = may edit files; shell commands need "auto" or "bypassPermissions"
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
CLAUDE_CODE_MAX_BUDGET_USD=2
CODEX_WORKDIR=
# workspace-write = may write inside CODEX_WORKDIR only
CODEX_SANDBOX=workspace-write
LOCAL_TASK_TIMEOUT_MIN=20
# Laptop opener (macOS `open`): on by default, set to "off" to disable
LAPTOP_ACTIONS=
GPU_WEBHOOK_URL=
GPU_WEBHOOK_KEY=
# More targets: EXTRA_TARGETS=render,n8n  then RENDER_WEBHOOK_URL=..., N8N_WEBHOOK_URL=...
EXTRA_TARGETS=
